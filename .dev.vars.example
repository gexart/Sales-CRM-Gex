# Copy to .dev.vars for local development. Never commit real secrets.
# Optional: Brevo transactional email (Phase 5). Leave unset to use the manual email workflow only.
# BREVO_API_KEY=
# Optional: AI provider for pitch/insight drafting (Phase D).
# ANTHROPIC_API_KEY=
# Optional: Google Places lead discovery (Phase E).
# GOOGLE_PLACES_API_KEY=
# BREVO_WEBHOOK_SECRET=
# YOUTUBE_API_KEY=
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# ROCKETREACH_API_KEY=
# LUSHA_API_KEY=
# Optional: EmailJS for welcome + password-reset emails (or set these in Settings -> Configuration).
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# APP_URL=https://sales.gexart.com
