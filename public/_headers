# Hashed build files never change, so phones can keep them for a year and skip the re-check on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and fonts rarely change.
/icon-*.png
  Cache-Control: public, max-age=604800
/favicon*
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# The service worker must always be re-checked so new releases reach installed phones.
/sw.js
  Cache-Control: no-cache
